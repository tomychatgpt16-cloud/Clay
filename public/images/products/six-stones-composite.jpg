<svg width="1800" height="1200" viewBox="0 0 1800 1200" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- 1. Axum Granite Black pattern -->
    <radialGradient id="axum-black-grad" cx="50%" cy="50%" r="70%">
      <stop offset="0%" stop-color="#242524" />
      <stop offset="50%" stop-color="#181918" />
      <stop offset="100%" stop-color="#0F100F" />
    </radialGradient>
    
    <!-- 2. Axum Granite White pattern -->
    <linearGradient id="axum-white-grad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#F2F1ED" />
      <stop offset="35%" stop-color="#E2E0D8" />
      <stop offset="70%" stop-color="#F5F5F2" />
      <stop offset="100%" stop-color="#D9D7CE" />
    </linearGradient>

    <!-- 3. Welega Marble White pattern -->
    <linearGradient id="welega-white-grad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#FAF9F7" />
      <stop offset="40%" stop-color="#FFFFFF" />
      <stop offset="70%" stop-color="#EDECE8" />
      <stop offset="100%" stop-color="#F5F4F0" />
    </linearGradient>

    <!-- 4. Welega Marble Gray pattern -->
    <linearGradient id="welega-gray-grad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#7B7B78" />
      <stop offset="45%" stop-color="#4F504E" />
      <stop offset="80%" stop-color="#9C9B97" />
      <stop offset="100%" stop-color="#3B3C3B" />
    </linearGradient>

    <!-- 5. Babile Granite pattern -->
    <linearGradient id="babile-grad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#CBB59E" />
      <stop offset="40%" stop-color="#AF9379" />
      <stop offset="70%" stop-color="#D9C7B2" />
      <stop offset="100%" stop-color="#93755C" />
    </linearGradient>

    <!-- 6. Limestone pattern -->
    <linearGradient id="limestone-grad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#EBE7DC" />
      <stop offset="50%" stop-color="#DCD6C7" />
      <stop offset="85%" stop-color="#EDE9DF" />
      <stop offset="100%" stop-color="#D5CEBE" />
    </linearGradient>
  </defs>

  <!-- Cell 1 (Row 1, Col 1): 1. Axum Granite Black -->
  <g transform="translate(0, 0)">
    <rect width="600" height="600" fill="url(#axum-black-grad)" />
    <!-- Granite flecks -->
    <circle cx="150" cy="200" r="3" fill="#6B6B67" opacity="0.6"/>
    <circle cx="380" cy="120" r="4" fill="#8E8E89" opacity="0.5"/>
    <circle cx="450" cy="380" r="3.5" fill="#525250" opacity="0.7"/>
    <circle cx="220" cy="460" r="5" fill="#3D3E3D" opacity="0.8"/>
    <rect x="20" y="20" width="560" height="560" stroke="#3F403E" stroke-width="1.5" fill="none" opacity="0.4"/>
    <text x="40" y="70" fill="#F4F3EF" font-family="Cinzel, serif" font-size="28" letter-spacing="2" font-weight="bold">01. AXUM GRANITE BLACK</text>
    <text x="40" y="105" fill="#B7B6B2" font-family="monospace" font-size="18" letter-spacing="1">10,300 ETB / m²</text>
  </g>

  <!-- Cell 2 (Row 1, Col 2): 2. Axum Granite White -->
  <g transform="translate(600, 0)">
    <rect width="600" height="600" fill="url(#axum-white-grad)" />
    <!-- Quartz & mica specks -->
    <circle cx="180" cy="190" r="4" fill="#3A3B3A" opacity="0.5"/>
    <circle cx="390" cy="240" r="3" fill="#686864" opacity="0.6"/>
    <circle cx="250" cy="430" r="5" fill="#202120" opacity="0.4"/>
    <circle cx="480" cy="140" r="4.5" fill="#525250" opacity="0.5"/>
    <rect x="20" y="20" width="560" height="560" stroke="#B7B6B2" stroke-width="1.5" fill="none" opacity="0.5"/>
    <text x="40" y="70" fill="#111211" font-family="Cinzel, serif" font-size="28" letter-spacing="2" font-weight="bold">02. AXUM GRANITE WHITE</text>
    <text x="40" y="105" fill="#5C5B57" font-family="monospace" font-size="18" letter-spacing="1">9,800 ETB / m²</text>
  </g>

  <!-- Cell 3 (Row 1, Col 3): 3. Welega Marble White -->
  <g transform="translate(1200, 0)">
    <rect width="600" height="600" fill="url(#welega-white-grad)" />
    <!-- Elegant soft smoke veins -->
    <path d="M50,150 Q180,240 280,180 T480,260 T580,210" stroke="#C8C7C3" stroke-width="6" fill="none" opacity="0.6"/>
    <path d="M80,380 Q220,330 360,420 T540,360" stroke="#B7B6B2" stroke-width="4" fill="none" opacity="0.5"/>
    <rect x="20" y="20" width="560" height="560" stroke="#D8D6D1" stroke-width="1.5" fill="none" opacity="0.6"/>
    <text x="40" y="70" fill="#111211" font-family="Cinzel, serif" font-size="28" letter-spacing="2" font-weight="bold">03. WELEGA MARBLE WHITE</text>
    <text x="40" y="105" fill="#5C5B57" font-family="monospace" font-size="18" letter-spacing="1">7,500 ETB / m²</text>
  </g>

  <!-- Cell 4 (Row 2, Col 1): 4. Welega Marble Gray -->
  <g transform="translate(0, 600)">
    <rect width="600" height="600" fill="url(#welega-gray-grad)" />
    <!-- Marble flow banding -->
    <path d="M30,120 Q160,220 320,150 T560,240" stroke="#E2E0D8" stroke-width="5" fill="none" opacity="0.4"/>
    <path d="M40,390 Q220,310 390,440 T570,330" stroke="#252625" stroke-width="7" fill="none" opacity="0.5"/>
    <rect x="20" y="20" width="560" height="560" stroke="#858582" stroke-width="1.5" fill="none" opacity="0.5"/>
    <text x="40" y="70" fill="#F4F3EF" font-family="Cinzel, serif" font-size="28" letter-spacing="2" font-weight="bold">04. WELEGA MARBLE GRAY</text>
    <text x="40" y="105" fill="#D8D6D1" font-family="monospace" font-size="18" letter-spacing="1">8,000 ETB / m²</text>
  </g>

  <!-- Cell 5 (Row 2, Col 2): 5. Babile Granite -->
  <g transform="translate(600, 600)">
    <rect width="600" height="600" fill="url(#babile-grad)" />
    <!-- Terracotta & quartz granite specks -->
    <circle cx="160" cy="180" r="5" fill="#784931" opacity="0.6"/>
    <circle cx="340" cy="220" r="6" fill="#3D291D" opacity="0.5"/>
    <circle cx="440" cy="380" r="4.5" fill="#E8D8C3" opacity="0.7"/>
    <circle cx="210" cy="450" r="5.5" fill="#5F3B25" opacity="0.6"/>
    <rect x="20" y="20" width="560" height="560" stroke="#8F7256" stroke-width="1.5" fill="none" opacity="0.5"/>
    <text x="40" y="70" fill="#1A140F" font-family="Cinzel, serif" font-size="28" letter-spacing="2" font-weight="bold">05. BABILE GRANITE</text>
    <text x="40" y="105" fill="#3F2D1E" font-family="monospace" font-size="18" letter-spacing="1">8,500 ETB / m²</text>
  </g>

  <!-- Cell 6 (Row 2, Col 3): 6. Limestone -->
  <g transform="translate(1200, 600)">
    <rect width="600" height="600" fill="url(#limestone-grad)" />
    <!-- Fine sedimentary grain stratification -->
    <path d="M40,160 Q200,150 400,170 T570,155" stroke="#C0B8A6" stroke-width="3" fill="none" opacity="0.7"/>
    <path d="M30,320 Q220,335 380,315 T560,330" stroke="#B0A793" stroke-width="2.5" fill="none" opacity="0.6"/>
    <rect x="20" y="20" width="560" height="560" stroke="#B7B6B2" stroke-width="1.5" fill="none" opacity="0.6"/>
    <text x="40" y="70" fill="#111211" font-family="Cinzel, serif" font-size="28" letter-spacing="2" font-weight="bold">06. LIMESTONE</text>
    <text x="40" y="105" fill="#5C5B57" font-family="monospace" font-size="18" letter-spacing="1">Contact for Quotation</text>
  </g>

  <!-- Grid Dividers -->
  <line x1="600" y1="0" x2="600" y2="1200" stroke="#111211" stroke-width="4" opacity="0.3" />
  <line x1="1200" y1="0" x2="1200" y2="1200" stroke="#111211" stroke-width="4" opacity="0.3" />
  <line x1="0" y1="600" x2="1800" y2="600" stroke="#111211" stroke-width="4" opacity="0.3" />
</svg>
